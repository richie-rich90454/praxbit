{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "useTabs": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "always",
    "printWidth": 100,
    "proseWrap": "never",
    "htmlWhitespaceSensitivity": "ignore",
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "embeddedLanguageFormatting": "auto",
    "singleAttributePerLine": false,
    "sortPackageJson": false,
    "ignorePatterns": [
        "**/dist/**",
        "**/node_modules/**",
        "**/coverage/**",
        "**/playwright-report/**",
        "**/test-results/**",
        "**/pnpm-lock.yaml",
        "apps/web/public/**"
    ]
}
