[Unit]
Description=Praxbit API (Hono)
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple
User=praxbit
Group=praxbit
WorkingDirectory=/opt/praxbit/current
EnvironmentFile=/etc/praxbit/praxbit.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/praxbit/current/apps/server/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077

# The service only listens on loopback and reads its release. It does not write
# learner data to local disk; PostgreSQL and journald own durable state.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictSUIDSGID=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Resource budget for a 2 vCPU / 2 GB host shared with other services.
# Validate with `systemd-cgtop` and `ps -o rss` before raising these values.
MemoryHigh=256M
MemoryMax=384M
CPUQuota=80%
TasksMax=64
LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=praxbit

[Install]
WantedBy=multi-user.target
