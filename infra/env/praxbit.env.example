# Copy this file to /etc/praxbit/praxbit.env and replace every placeholder.
# Never commit the real file. Do not put these values in the web bundle.
# `praxbit.service` reads this file as root:praxbit with mode 0640.

NODE_ENV=production
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=https://praxbit.example
CORS_ORIGINS=https://praxbit.example
TRUST_PROXY=1
COOKIE_SECURE=1

# PostgreSQL 16+. Prefer a dedicated role that owns only the praxbit database.
DATABASE_URL=postgres://praxbit:replace-with-a-real-password@127.0.0.1:5432/praxbit
DB_POOL_SIZE=3

# Leave empty to resolve content relative to the release directory.
CONTENT_DIR=/opt/praxbit/current/content

# Comma-separated lowercase handles. These accounts receive the admin role at
# registration. Keep this list small and review it after every deploy.
ADMIN_HANDLES=

# Optional AI tutor gateway. All three of AI_BASE_URL, AI_API_KEY, and AI_MODEL
# must be set to enable it. The server calls an OpenAI-compatible endpoint.
# AI_BASE_URL=https://provider.example/v1
# AI_API_KEY=replace-with-a-provider-key
# AI_MODEL=replace-with-a-model-name
# AI_TIMEOUT_MS=12000

# Request body limit in bytes. The server accepts 16384..2097152.
BODY_LIMIT_BYTES=262144
