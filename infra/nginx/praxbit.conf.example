# Praxbit behind an existing Nginx installation.
# This file is an example only. Include it from the host's existing http block;
# do not replace unrelated server blocks.

upstream praxbit_api {
    server 127.0.0.1:8787;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name praxbit.example;

    # Terminate TLS in the existing installation, or enable Certbot separately.
    # return 301 https://$host$request_uri;

    root /opt/praxbit/current/apps/web/dist;
    index index.html;
    client_max_body_size 2m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Preserve the /api prefix. The Hono app mounts under /api/v1.
    location /api/ {
        proxy_pass http://praxbit_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 30s;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # Content-Security-Policy is deliberately omitted until the bundle,
    # Pyodide worker, and sandboxed previews have been tested against it.
}
