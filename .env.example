# Praxbit deployment environment.
# Copy this file to .env in the project root and edit DATABASE_URL.
# The server loads .env automatically. Shell variables take precedence.

NODE_ENV=production
HOST=0.0.0.0
PORT=8787

# PostgreSQL 16 or newer. Create the database and role first.
DATABASE_URL=postgresql://praxbit:change-me@127.0.0.1:5432/praxbit
DB_POOL_SIZE=3

# Same-origin deployment. Leave CORS_ORIGINS empty unless the web app is
# served from a different origin than the API.
PUBLIC_ORIGIN=http://localhost:8787
CORS_ORIGINS=

# Set to 1 only when the site is served over HTTPS.
COOKIE_SECURE=0
TRUST_PROXY=0

# Comma-separated lowercase handles promoted to administrators at startup.
ADMIN_HANDLES=

# Optional absolute or project-relative paths. Empty uses the repository
# defaults: content/ and apps/web/dist.
CONTENT_DIR=
WEB_DIST=

BODY_LIMIT_BYTES=1048576

# Optional OpenAI-compatible tutor. Leave blank to keep the curated hints.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=12000
