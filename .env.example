# Praxbit environment template.
# Copy this file to .env in the project root, then edit DATABASE_URL.
# The server loads .env automatically. Shell variables take precedence.
#
# Both https://praxbit.biszweb.club and https://praxbit.bisz.dev serve the same
# application behind Caddy or Nginx. PUBLIC_ORIGIN is the primary canonical
# origin; it does not limit which Host names the server accepts. Cookies are
# host-only, so sessions do not cross the two hostnames.

NODE_ENV=production
HOST=127.0.0.1
PORT=8787

# PostgreSQL 16 or newer. Create the database and role first.
DATABASE_URL=postgresql://praxbit:change-me@127.0.0.1:5432/praxbit
DB_POOL_SIZE=3

# Same-origin deployment. Leave CORS_ORIGINS empty because each hostname
# serves both the web client and the API.
PUBLIC_ORIGIN=https://praxbit.bisz.dev
CORS_ORIGINS=

# Both values are required behind the TLS proxy. Use COOKIE_SECURE=0 and
# TRUST_PROXY=0 only for direct local HTTP development.
COOKIE_SECURE=1
TRUST_PROXY=1

# Comma-separated lowercase handles promoted to administrators at startup.
ADMIN_HANDLES=

# Optional absolute or project-relative paths. Empty uses the repository
# defaults: content/ and apps/web/dist.
CONTENT_DIR=
WEB_DIST=

# Keep the proxy body limit aligned with this value.
BODY_LIMIT_BYTES=1048576

# Optional OpenAI-compatible tutor. Leave blank to keep the curated hints.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=12000
