    "lesson": {
        "sections": [
            {
                "title": "Python lists and dictionaries",
                "body": "A list holds ordered values. A dictionary maps keys to values. A list of dictionaries is a common shape for JSON-like data. Iterating with for gives each dictionary a name inside the loop body."
            },
            {
                "title": "Accumulate, then return",
                "body": "A total starts at zero. Each iteration adds one value. The return happens after the loop so it includes every item. Returning inside the loop exits after the first or last value."
            }
        ],
        "vocabulary": [
            {
                "term": "List",
                "definition": "An ordered Python collection."
            },
            {
                "term": "Dictionary",
                "definition": "A collection of key-value pairs."
            },
            {
                "term": "Accumulator",
                "definition": "A variable collecting a result across iterations."
            }
        ]
    },
