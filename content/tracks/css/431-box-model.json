    "lesson": {
        "sections": [
            {
                "title": "The box model",
                "body": "Every element is a box with content, padding, border, and margin. Padding is inside the border; margin is outside it."
            },
            {
                "title": "box-sizing",
                "body": "content-box adds padding and border to the declared width. border-box includes them, preventing overflow."
            }
        ],
        "vocabulary": [
            {
                "term": "Padding",
                "definition": "Space between content and border."
