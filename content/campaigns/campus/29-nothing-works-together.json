        "action": "integrate-systems",
        "system": "api"
    },
    "accessibility": {
        "summary": "The editor and tests are keyboard accessible. Each test lists the full input and expected result.",
        "keyboardNotes": "Ctrl+Enter runs tests. Results are focusable headings for quick navigation.",
