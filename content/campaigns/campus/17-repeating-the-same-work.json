    "assets": ["pip:thinking", "scene:campus", "system:storefront", "icon:loop"],
    "hints": [
        "Start a total at zero and visit each item in the array.",
        "For each item, availability is stock minus reserved.",
        "A product cannot have less than zero available. Clamp the difference at zero.",
        "Loop over items, add Math.max(0, item.stock - item.reserved) to total, and return total."
    ],
    "misconceptions": [
        {
            "id": "ignores-reserved",
            "description": "Summing stock without subtracting reservations.",
            "stepId": "available-total",
            "feedback": "Reserved units are already promised to other orders. Subtract them before counting availability."
        },
        {
            "id": "negative-availability",
            "description": "Allowing reserved stock to produce a negative total.",
            "stepId": "available-total",
            "feedback": "A reservation mistake should not create negative physical stock. Clamp each product's availability at zero."
        }
    ],
    "lesson": {
        "sections": [
            {
                "title": "Loops process collections",
                "body": "A for...of loop visits each element of an array. The loop body performs the same operation for every item, while an accumulator carries the result forward. This is the core pattern behind totals, filters, and transformations."
            },
            {
                "title": "Reservations are state",
                "body": "Stock minus reserved is the amount actually available. If reserved exceeds stock, the data may be inconsistent, but the available count should not become negative. Clamping preserves a truthful lower bound while the underlying data issue can be investigated."
            }
        ],
        "vocabulary": [
            {
                "term": "Array",
                "definition": "An ordered collection of values."
            },
            {
                "term": "Accumulator",
                "definition": "A variable that carries a running result through a loop."
            },
            {
                "term": "Clamp",
                "definition": "Restrict a value to a defined minimum or maximum."
            }
        ]
    },
    "steps": [
        {
            "kind": "code",
            "id": "available-total",
            "title": "Compute available stock",
            "prompt": "Edit stock.js. sumAvailable(items) must loop over the array and return the total available, with each item clamped at zero.",
            "evidence": "construction",
            "language": "javascript",
            "files": [
                {
                    "path": "stock.js",
                    "content": "function sumAvailable(items) {\n  let total = 0;\n  for (let index = 0; index < items.length; index += 1) {\n    total += items[index].stock;\n  }\n  return total;\n}\n",
                    "editable": true,
                    "language": "javascript"
                }
            ],
            "entry": "stock.js",
            "preview": "console",
