# Praxbit production environment template.
# Copy to .env in the project root and replace every placeholder before start:
#   cp .env.production.example .env
#   chmod 600 .env
#
# Both https://praxbit.biszweb.club and https://praxbit.bisz.dev serve the same
# application behind Caddy or Nginx. PUBLIC_ORIGIN is the primary canonical
# origin; it does not limit which Host names the server accepts. Cookies are
# host-only, so sessions do not cross the two hostnames.

NODE_ENV=production
HOST=127.0.0.1
PORT=8787

# PostgreSQL 16 or newer. Use a dedicated role and a strong password.
DATABASE_URL=postgresql://praxbit:replace-this-password@127.0.0.1:5432/praxbit
DB_POOL_SIZE=3

# Native clients call the API cross-origin: Android uses https://localhost,
# iOS uses capacitor://localhost. Remove these only if native builds are disabled.
PUBLIC_ORIGIN=https://praxbit.bisz.dev
CORS_ORIGINS=https://localhost,capacitor://localhost

# Required when the trusted proxy terminates TLS and overwrites X-Forwarded-For.
COOKIE_SECURE=1
TRUST_PROXY=1

# Comma-separated lowercase handles promoted to administrators at startup.
ADMIN_HANDLES=

# Optional absolute or project-relative paths. Empty uses content/ and
# apps/web/dist under the repository root.
CONTENT_DIR=
WEB_DIST=

# Keep the proxy body limit aligned with this value.
BODY_LIMIT_BYTES=1048576

# Optional OpenAI-compatible tutor. Leave all three blank to keep the curated
# hints and make no external AI request.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=12000
