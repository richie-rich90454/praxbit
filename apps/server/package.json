{
    "name": "@praxbit/server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/main.ts",
        "start": "node dist/main.js",
        "build": "node ../../scripts/build-server.mjs",
        "typecheck": "tsc -p tsconfig.json",
        "test:integration": "node ../../node_modules/tsx/dist/cli.mjs scripts/run-integration-tests.ts",
        "db:migrate": "node-pg-migrate up --migrations-dir ../../database/migrations --database-url-var DATABASE_URL",
        "db:rollback": "node-pg-migrate down --migrations-dir ../../database/migrations --database-url-var DATABASE_URL"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.5",
        "@hono/zod-validator": "^0.9.1",
        "@praxbit/contracts": "workspace:*",
        "@praxbit/domain": "workspace:*",
        "hono": "^4.13.14",
        "pg": "^8.23.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/pg": "^8.23.1",
        "node-pg-migrate": "^9.0.0"
    }
}
